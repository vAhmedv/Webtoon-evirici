{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [".kilo/venvs/graphify/Scripts/python.exe", "-m", "graphify.serve", "graphify-out/graph.json"],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": ["uvx", "serena-agent", "start-mcp-server", "--project-from-cwd"],
      "enabled": true
    }
  }
}
